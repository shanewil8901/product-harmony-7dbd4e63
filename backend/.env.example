PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=root
DB_DATABASE=product_management

# Set to false to boot without letting TypeORM alter the existing schema
DB_SYNC=true

JWT_SECRET=change-me-in-production
# Session length. The frontend slides this forward while the user is active.
JWT_EXPIRES_IN=10m

# KSA GS1 company prefix (4-11 digits). Used to build the 13-digit EAN-13 barcode.
KSA_COMPANY_PREFIX=6281234

# Max upload size in MB for vendor/customer documents
MAX_UPLOAD_MB=10

# ---- Background processing (BullMQ / Redis) ----
# Leave QUEUE_ENABLED=false to run without Redis; jobs then execute inline.
QUEUE_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
QUEUE_PREFIX=erp

# ---- Public URLs (domain resolved from the environment) ----
# Public base URL of this API behind ingress / reverse proxy.
PUBLIC_API_URL=http://localhost:3000
# Global route prefix (no leading slash).
API_PREFIX=api/v1
# Comma-separated browser origins allowed by CORS. Empty = allow all (dev).
CORS_ORIGIN=

# --- API location (domain comes from the environment, never hardcoded) ---
# Option A: full base URL (wins over the two below)
# Local dev:    http://localhost:3000/api/v1
# Docker / K8s: /api/v1   (nginx proxies /api to the backend service)
VITE_API_URL=http://localhost:3000/api/v1

# Option B: domain + prefix (leave VITE_API_URL empty to use these)
# VITE_API_DOMAIN=https://erp.example.com
# VITE_API_PREFIX=api/v1
